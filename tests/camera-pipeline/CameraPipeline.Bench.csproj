<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>CameraPipeline.Bench</AssemblyName>
    <RootNamespace>CameraPipeline.QA</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Data" /><Reference Include="System.Xml" /><Reference Include="System.Web.Extensions" />
    <Compile Include="Fixture.cs" /><Compile Include="Metrics.cs" /><Compile Include="FakeBoundaries.cs" /><Compile Include="Program.cs" />
    <Compile Include="$(ExtractedSource)" />
  </ItemGroup>
  <Target Name="RequireIsolatedOutput" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ExtractedSource)' == '' Or '$(OutputPath)' == '' Or '$(IntermediateOutputPath)' == ''" Text="Use run-benchmark.ps1 with explicit extraction and isolated output paths after acquiring the build slot." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
