    <Compile Include="..\..\SPMS1\OmronPLC_Hsl.cs"><Link>Production\LegacyOmron.cs</Link></Compile>
    <Compile Include="..\..\SPMS1\OmronPLC_Hsl.Designer.cs"><Link>Production\LegacyOmron.Designer.cs</Link></Compile>
